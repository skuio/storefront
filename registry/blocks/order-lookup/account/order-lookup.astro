---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { config } from '../../lib/catalog'

export const prerender = true

const phone = config.contact?.phone
---

<BaseLayout title="Order status" description="Check the status of your order with your email address and order reference.">
  <div class="mx-auto max-w-xl px-5 py-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Order status' }]} />
    <h1 class="display-heading mt-6 text-5xl">Order status</h1>
    <p class="mt-3 text-sm">Enter the email you ordered with and the reference from your confirmation.</p>

    <form method="POST" action="/api/order-lookup" class="mt-8 space-y-4" data-lookup-form>
      <div>
        <label for="email" class="block text-xs font-semibold tracking-wide text-ink uppercase">Email address</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 text-sm focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
      </div>
      <div>
        <label for="reference" class="block text-xs font-semibold tracking-wide text-ink uppercase">Order reference</label>
        <input id="reference" name="reference" type="text" required minlength="6" placeholder="e.g. B1ARO8YDV9ZJ" autocomplete="off" spellcheck="false"
          class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 font-mono text-sm tracking-wider uppercase focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
      </div>
      <button type="submit" class="w-full rounded-md bg-accent px-8 py-3 text-sm font-bold tracking-wide text-white uppercase transition hover:bg-accent-dark disabled:opacity-60">
        Find my order
      </button>
    </form>

    <div class="mt-6 hidden rounded-lg border border-rule" data-lookup-result></div>
    <div class="mt-6 hidden rounded-md border border-accent/30 bg-accent/5 px-4 py-3 text-sm text-accent" role="alert" data-lookup-error></div>

    {phone && <p class="mt-8 text-xs text-body/70">Can't find it? Call <a href={`tel:${config.contact?.phoneE164 ?? phone}`} class="font-semibold text-accent">{phone}</a>.</p>}
  </div>
</BaseLayout>

<script>
  interface LookupResponse {
    ok: boolean
    error?: string
    order?: {
      reference: string
      createdAt: string
      paymentStatus: string
      total: { amount: number; currency: string }
      lines: { name: string; quantity: number }[]
      shipTo: string | null
      tracking: { number: string; carrier: string | null } | null
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-lookup-form]')!
  const result = document.querySelector<HTMLElement>('[data-lookup-result]')!
  const errorBox = document.querySelector<HTMLElement>('[data-lookup-error]')!
  const fmt = (m: { amount: number; currency: string }) =>
    new Intl.NumberFormat(undefined, { style: 'currency', currency: m.currency }).format(m.amount / 100)
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)

  form.addEventListener('submit', async (event) => {
    event.preventDefault()
    const button = form.querySelector<HTMLButtonElement>('button')!
    button.disabled = true
    result.classList.add('hidden')
    errorBox.classList.add('hidden')

    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) })
      const data = (await res.json()) as LookupResponse
      if (!data.ok || !data.order) {
        errorBox.textContent =
          data.error === 'not_found'
            ? 'We could not find an order for that email and reference. Check both against your confirmation email.'
            : 'We could not look that up right now. Please try again in a moment.'
        errorBox.classList.remove('hidden')
        return
      }
      const o = data.order
      const status = o.tracking
        ? `Shipped${o.tracking.carrier ? ` via ${esc(o.tracking.carrier)}` : ''} — tracking <strong>${esc(o.tracking.number)}</strong>`
        : o.paymentStatus === 'paid'
          ? 'Paid — being prepared for shipment'
          : `Payment ${esc(o.paymentStatus)}`
      result.innerHTML = `
        <div class="p-4 text-sm">
          <p class="text-[11px] font-semibold tracking-widest text-body/60 uppercase">Order ${esc(o.reference)} · ${new Date(o.createdAt).toLocaleDateString()}</p>
          <p class="mt-2 font-semibold text-ink">${status}</p>
          <ul class="mt-3 space-y-1">${o.lines.map((l) => `<li>${l.quantity} × ${esc(l.name)}</li>`).join('')}</ul>
          ${o.shipTo ? `<p class="mt-3 text-body/70">Shipping to ${esc(o.shipTo)}</p>` : ''}
          <p class="mt-3 font-semibold text-ink">Total ${fmt(o.total)}</p>
        </div>`
      result.classList.remove('hidden')
    } catch {
      errorBox.textContent = 'We could not look that up right now. Please try again in a moment.'
      errorBox.classList.remove('hidden')
    } finally {
      button.disabled = false
    }
  })
</script>
