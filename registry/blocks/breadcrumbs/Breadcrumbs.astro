---
interface Crumb {
  label: string
  href?: string
}

interface Props {
  items: Crumb[]
}

const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="text-xs">
  <ol class="flex flex-wrap items-center gap-1.5 text-body/70">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {item.href && i < items.length - 1 ? (
            <a href={item.href} class="transition-colors hover:text-accent">{item.label}</a>
          ) : (
            <span aria-current="page" class="text-ink">{item.label}</span>
          )}
          {i < items.length - 1 && <span aria-hidden="true" class="text-body/35">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
