---
import type { Product } from '@skuio/storefront'
import { routes, store } from '../lib/store'
import { resolveImage } from '../lib/images'
import Price from './Price.astro'

interface Props {
  product: Product
  loading?: 'eager' | 'lazy'
}

const { product, loading = 'lazy' } = Astro.props
// One catalog snapshot per request: store(Astro) is memoised on Astro.locals.
const catalog = await store(Astro).catalog.load()
const img = resolveImage(product.images[0])
const href = routes.product(product, catalog)
const onSale = product.compareAtPrice && product.compareAtPrice.amount > product.price.amount
---

<article class="group h-full">
  <a href={href} class="flex h-full flex-col overflow-hidden rounded-lg border border-rule transition hover:shadow-md">
    <div class="relative aspect-4/3 overflow-hidden bg-panel-2">
      {
        img ? (
          <img
            src={img.src}
            width={img.width}
            height={img.height}
            alt={product.images[0]?.alt ?? product.name}
            loading={loading}
            decoding="async"
            class="h-full w-full object-contain p-3 transition duration-300 group-hover:scale-105"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-xs text-body/50">No image</div>
        )
      }
      {
        onSale && (
          <span class="absolute top-3 left-3 rounded-full bg-accent px-2.5 py-1 text-[11px] font-bold tracking-wide text-on-accent uppercase">
            Sale
          </span>
        )
      }
      {
        !product.available && (
          <span class="absolute top-3 right-3 rounded-full bg-ink/80 px-2.5 py-1 text-[11px] font-bold tracking-wide text-page uppercase">
            Sold out
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col gap-2 border-t border-rule p-4">
      <h3 class="text-[13px] leading-snug font-semibold text-ink group-hover:text-accent">{product.name}</h3>
      <p class="text-[11px] tracking-wide text-body/60 uppercase">SKU {product.sku}</p>
      <p class="mt-auto pt-1">
        <Price price={product.price} compareAt={product.compareAtPrice} />
      </p>
    </div>
  </a>
</article>
