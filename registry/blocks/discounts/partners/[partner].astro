---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PartnerDashboard from '../../components/PartnerDashboard.astro'
import { store } from '../../lib/store'

/**
 * The same dashboard behind a private key link, for a partner with no email on
 * file: /partners/<partner>/?key=<HMAC of the partner id under SESSION_SECRET>.
 * Rotating the secret revokes every key link.
 */
export const prerender = false

const partner = Astro.params.partner ?? ''
if (partner === 'dashboard' || partner === 'verify') return Astro.redirect('/partners/', 303)
const allowed = await store(Astro).partners.verifyReportKey(partner, Astro.url.searchParams.get('key'))
if (!allowed) return new Response('Not found', { status: 404 })
---

<BaseLayout title="Partner dashboard" noindex>
  <PartnerDashboard partner={partner} />
</BaseLayout>
