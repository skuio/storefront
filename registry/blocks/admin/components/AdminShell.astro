---
import type { Owner } from '@skuio/storefront/store'
import BaseLayout from '../layouts/BaseLayout.astro'
import { config } from '../lib/store'

/**
 * The frame every owner page sits in: the store's own header and footer, a
 * thin admin bar with the owner's email and sign-out, and the reminder that
 * day-to-day operations live in SKU.io. No new design system.
 */
interface Props {
  title: string
  owner?: Owner | null
  /** Narrow (sign-in, approve) or regular (dashboard, connections). */
  width?: 'narrow' | 'regular'
}

const { title, owner = null, width = 'regular' } = Astro.props
const path = Astro.url.pathname
const nav = [
  { href: '/admin/', label: 'Overview' },
  { href: '/admin/orders/', label: 'Orders' },
  { href: '/admin/partners/', label: 'Partners' },
  { href: '/admin/connections/', label: 'Connections' },
]
---

<BaseLayout title={`${title} · Admin`} noindex>
  <div class:list={['mx-auto px-5 py-10', width === 'narrow' ? 'max-w-md' : 'max-w-4xl']}>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-4 text-xs">
      <div class="flex items-center gap-4">
        <span class="font-bold tracking-wide text-ink uppercase">{config.name} · Admin</span>
        {owner && nav.map((n) => (
          <a href={n.href} class:list={['font-semibold tracking-wide uppercase hover:text-accent', path === n.href || (n.href !== '/admin/' && path.startsWith(n.href)) ? 'text-accent' : 'text-body/70']}>{n.label}</a>
        ))}
      </div>
      {owner && (
        <div class="flex items-center gap-3 text-body/70">
          <span>{owner.email}</span>
          <form method="POST" action="/api/admin/sign-out">
            <button type="submit" class="font-semibold tracking-wide uppercase hover:text-accent">Sign out</button>
          </form>
        </div>
      )}
    </div>
    <h1 class="display-heading mt-6 text-4xl">{title}</h1>
    <slot />
  </div>
</BaseLayout>
