---
import { PASSWORD_MIN_LENGTH } from '@skuio/storefront/store'
import AdminShell from '../../components/AdminShell.astro'

// The reset link lands here. The token is only ever checked on submit, so a
// link preview fetch cannot burn it.
export const prerender = false

const token = Astro.url.searchParams.get('token') ?? ''
if (!token) return Astro.redirect('/admin/forgot-password/', 303)
const error = Astro.url.searchParams.get('error')
const message =
  error === 'mismatch' ? 'The two passwords do not match.'
  : error === 'weak' ? `Use at least ${PASSWORD_MIN_LENGTH} characters.`
  : error === 'origin' ? 'The form was submitted from another site. Try again from this page.'
  : error ? 'Something went wrong. Try again.'
  : null
---

<AdminShell title="Choose a new password" width="narrow">
  {message && <p class="mt-4 rounded-md border border-accent/30 bg-accent/5 px-4 py-3 text-sm text-accent" role="alert">{message}</p>}
  <form method="POST" action="/api/admin/reset" class="mt-6 space-y-4">
    <input type="hidden" name="token" value={token} />
    <div>
      <label for="password" class="block text-xs font-semibold tracking-wide text-ink uppercase">New password</label>
      <input id="password" name="password" type="password" required minlength={PASSWORD_MIN_LENGTH} autocomplete="new-password"
        class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 text-sm focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
      <p class="mt-1 text-xs text-body/70">At least {PASSWORD_MIN_LENGTH} characters. A sentence works well.</p>
    </div>
    <div>
      <label for="confirm" class="block text-xs font-semibold tracking-wide text-ink uppercase">Repeat it</label>
      <input id="confirm" name="confirm" type="password" required minlength={PASSWORD_MIN_LENGTH} autocomplete="new-password"
        class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 text-sm focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
    </div>
    <button type="submit" class="w-full rounded-md bg-accent px-8 py-3 text-sm font-bold tracking-wide text-white uppercase transition hover:bg-accent-dark">Save password</button>
  </form>
</AdminShell>
