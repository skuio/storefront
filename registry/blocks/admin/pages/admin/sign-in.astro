---
import AdminShell from '../../components/AdminShell.astro'
import { store } from '../../lib/store'
import { readOwnerSession, safeNext } from '../../lib/admin'

// Password sign-in for the store owner. Every path is server-rendered.
export const prerender = false

const s = store(Astro)
const next = safeNext(Astro.url.searchParams.get('next'))
if (await s.owners.resolve(readOwnerSession(Astro.cookies))) return Astro.redirect(next, 303)

const error = Astro.url.searchParams.get('error')
const reset = Astro.url.searchParams.get('reset') === '1'
const ownerConfigured = (await s.owners.count()) > 0
const message =
  error === 'credentials' ? 'That email and password do not match.'
  : error === 'locked' ? 'Too many attempts. Wait a few minutes and try again.'
  : error === 'origin' ? 'The sign-in form was submitted from another site. Try again from this page.'
  : null
---

<AdminShell title="Sign in" width="narrow">
  {reset && (
    <p class="mt-4 rounded-md border border-green-600/30 bg-green-50 px-4 py-3 text-sm text-green-800" role="status">Your password has been changed. Sign in with the new one.</p>
  )}
  {message && <p class="mt-4 rounded-md border border-accent/30 bg-accent/5 px-4 py-3 text-sm text-accent" role="alert">{message}</p>}

  {
    ownerConfigured ? (
      <form method="POST" action="/api/admin/session" class="mt-6 space-y-4">
        <input type="hidden" name="next" value={next} />
        <div>
          <label for="email" class="block text-xs font-semibold tracking-wide text-ink uppercase">Email</label>
          <input id="email" name="email" type="email" required autocomplete="username"
            class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 text-sm focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
        </div>
        <div>
          <label for="password" class="block text-xs font-semibold tracking-wide text-ink uppercase">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password"
            class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 text-sm focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
        </div>
        <button type="submit" class="w-full rounded-md bg-accent px-8 py-3 text-sm font-bold tracking-wide text-white uppercase transition hover:bg-accent-dark">Sign in</button>
        <p class="text-xs text-body/70"><a href="/admin/forgot-password/" class="font-semibold text-accent">Forgot your password?</a></p>
      </form>
    ) : (
      <div class="mt-6 rounded-md border border-rule bg-[#fafafa] p-4 text-sm">
        <p class="font-semibold text-ink">No owner has been set up yet.</p>
        <p class="mt-2">Create one from the store's checkout with:</p>
        <pre class="mt-2 overflow-x-auto rounded bg-ink px-3 py-2 text-xs text-white">npm run owner:create -- --email you@example.com --name "Your Name"</pre>
        <p class="mt-2 text-xs text-body/70">It prompts for a password and writes the owner straight to the database. There is no public sign-up.</p>
      </div>
    )
  }
</AdminShell>
