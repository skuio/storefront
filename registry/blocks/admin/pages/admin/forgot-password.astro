---
import AdminShell from '../../components/AdminShell.astro'

// Ask for a reset link. The confirmation reads the same whether or not the
// address belongs to an owner.
export const prerender = false

const sent = Astro.url.searchParams.get('sent') === '1'
const error = Astro.url.searchParams.get('error')
---

<AdminShell title="Reset your password" width="narrow">
  {error === 'link' && (
    <p class="mt-4 rounded-md border border-accent/30 bg-accent/5 px-4 py-3 text-sm text-accent" role="alert">That reset link has expired or was already used. Request a new one below.</p>
  )}
  {
    sent ? (
      <div class="mt-6 rounded-md border border-green-600/30 bg-green-50 p-4 text-sm text-green-800" role="status">
        <p class="font-semibold">Check your email.</p>
        <p class="mt-1">If that address belongs to a store owner, a reset link is on its way. It works once and expires in 30 minutes.</p>
      </div>
    ) : (
      <form method="POST" action="/api/admin/reset-request" class="mt-6 space-y-4">
        <p class="text-sm">Enter the owner email and we will send a link to choose a new password.</p>
        <div>
          <label for="email" class="block text-xs font-semibold tracking-wide text-ink uppercase">Email</label>
          <input id="email" name="email" type="email" required autocomplete="username"
            class="mt-1.5 w-full rounded-md border border-rule px-3 py-2.5 text-sm focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none" />
        </div>
        <button type="submit" class="w-full rounded-md bg-accent px-8 py-3 text-sm font-bold tracking-wide text-on-accent uppercase transition hover:bg-accent-dark">Email me a reset link</button>
        <p class="text-xs text-body/70"><a href="/admin/sign-in/" class="font-semibold text-accent">Back to sign in</a></p>
      </form>
    )
  }
</AdminShell>
