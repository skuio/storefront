---
import { formatMoney, type Product } from '@skuio/storefront'
import { config } from '../lib/store'

interface Props {
  product: Product
}

const { product } = Astro.props
const max = config.checkout.maxQuantity
const low = product.availability?.status === 'low_stock' ? product.availability.quantity : undefined
---

{/*
  A real form, not a fetch. It takes the buyer to /checkout/ with this SKU and
  quantity, where the store collects the address and hands off to the payment
  adapter. Works without JavaScript; the script only adds a pending state.

  There is no price field. Checkout prices every SKU on the server, so nothing
  a client can edit reaches the payment processor.
*/}
<form method="GET" action="/checkout/" class="mt-7" data-buy-form>
  <input type="hidden" name="sku" value={product.sku} />

  <div class="flex flex-wrap items-stretch gap-3">
    <label class="sr-only" for={`qty-${product.sku}`}>Quantity</label>
    <input
      id={`qty-${product.sku}`}
      name="quantity"
      type="number"
      inputmode="numeric"
      value="1"
      min="1"
      max={max}
      disabled={!product.available}
      class="w-20 rounded-md border border-rule px-3 py-3 text-center text-sm font-semibold text-ink focus:border-accent focus:ring-2 focus:ring-accent/25 focus:outline-none disabled:opacity-50"
    />

    <button
      type="submit"
      disabled={!product.available}
      class="flex-1 rounded-md bg-accent px-8 py-3.5 text-sm font-bold tracking-wide text-on-accent uppercase transition hover:bg-accent-dark focus:ring-2 focus:ring-accent/40 focus:ring-offset-2 focus:outline-none disabled:cursor-not-allowed disabled:opacity-60"
      data-buy-submit
    >
      <span data-buy-label>
        {product.available ? `Buy now — ${formatMoney(product.price, config.locale)}` : 'Sold out'}
      </span>
    </button>
  </div>

  {low !== undefined && <p class="mt-3 text-xs font-semibold text-accent">Only {low} left in stock.</p>}
  {product.availability?.status === 'backorder' && <p class="mt-3 text-xs text-body/70">On backorder — ships as soon as stock arrives.</p>}
  <p class="mt-3 text-xs text-body/70">Secure checkout. Card, Apple Pay and Google Pay accepted.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-buy-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('[data-buy-submit]')
    const label = form.querySelector<HTMLElement>('[data-buy-label]')
    if (!button || !label) return
    const original = label.textContent
    form.addEventListener('submit', () => {
      button.disabled = true
      label.textContent = 'Taking you to checkout…'
      window.setTimeout(() => {
        if (!document.hidden) {
          button.disabled = false
          label.textContent = original
        }
      }, 12000)
    })
  })
</script>
