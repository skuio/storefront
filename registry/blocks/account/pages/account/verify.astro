---
import { store } from '../../lib/store'
import { writeSession } from '../../lib/account'

// The magic link lands here. Exchange the token, set the cookie, move on.
// No HTML is ever rendered by this route: every path is a redirect.
export const prerender = false

const token = Astro.url.searchParams.get('token')
if (!token) return Astro.redirect('/account/?error=link', 303)

try {
  const session = await store(Astro).sessions.exchange(token)
  writeSession(Astro.cookies, session.token, session.expiresAt, Astro.url.protocol === 'https:')
  return Astro.redirect('/account/orders/', 303)
} catch (error) {
  console.warn('account: token exchange failed', error instanceof Error ? error.message : error)
  return Astro.redirect('/account/?error=link', 303)
}
---
