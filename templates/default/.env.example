# Local development only. In production these are Worker secrets (`wrangler secret put`).

# Stripe — use a test-mode key until you go live.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid — the contact form and order notifications send through it.
# MAIL_FROM must be a verified sender identity or SendGrid answers 403.
SENDGRID_API_KEY=SG....
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=My Store

# Who hears about new orders and contact-form messages.
ORDER_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Only needed when the dev server's origin differs from the public one.
# PUBLIC_SITE_URL=https://www.example.com
