{
  "name": "@skuio/template-default",
  "description": "Reference storefront: Astro on Cloudflare Workers + D1, the store platform from @skuio/storefront.",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "e2e": "playwright test",
    "db:migrate:local": "node scripts/db-migrate.mjs --local",
    "db:migrate": "node scripts/db-migrate.mjs --remote",
    "seed": "node scripts/seed-store.mjs --local",
    "seed:remote": "node scripts/seed-store.mjs --remote",
    "migrate:woocommerce": "node scripts/export-woocommerce.mjs",
    "migrate:images": "node scripts/fetch-images.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@skuio/storefront": "*",
    "astro": "^5.14.1",
    "stripe": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.14",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
