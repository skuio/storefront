# Local development only: copy to .dev.vars (gitignored). The Cloudflare platform
# proxy hands these to the Worker under `astro dev`, alongside the local D1 database.
# In production every one of these is a Worker secret (`wrangler secret put NAME`).

# Bearer key SKU.io uses to call the Store API. Generate with `openssl rand -hex 32`.
STORE_API_KEY=
# Signs buyer session hashes. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Comma list, in the order checkout offers them: stripe (hosted Checkout), paypal (Orders v2),
# btcpay (Bitcoin / Lightning via BTCPay Server), bitcoin (on-chain to a hardware wallet's zpub), manual (pay later; operations marks the order paid).
# Each processor's webhook points at /api/payments/webhook?provider=<id>.
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
# bitcoin: on-chain to a hardware wallet. The account PUBLIC key (zpub…), never a seed or private key.
BITCOIN_XPUB=
# Optional block explorer API (default https://mempool.space/api)
BITCOIN_EXPLORER=

# console (log every email — fine for development), cloudflare (Email Service send_email binding EMAIL + MAIL_FROM) or sendgrid.
MAIL_PROVIDER=console
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=

# Absolute public origin for links in emails and processor return URLs.
PUBLIC_SITE_URL=http://localhost:4321

# Who hears about paid orders and contact-form messages (optional).
ORDER_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
