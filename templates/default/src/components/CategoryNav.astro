---
import type { CategoryNode } from '@skuio/storefront'
import { routes } from '../lib/catalog'

interface Props {
  nodes: CategoryNode[]
  label: string
  /** Show product counts next to names. */
  counts?: boolean
}

const { nodes, label, counts = true } = Astro.props
const visible = nodes.filter((n) => n.productCount > 0)
---

{
  visible.length > 0 && (
    <nav aria-label={label}>
      <h2 class="text-[11px] font-semibold tracking-widest text-body/60 uppercase">{label}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {visible.map((node) => (
          <li>
            <a
              href={routes.category(node)}
              class="inline-block rounded-full border border-rule px-3.5 py-1.5 text-xs font-medium transition hover:border-accent hover:text-accent"
            >
              {node.name}
              {counts && <span class="ml-1 text-body/50">{node.productCount}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
