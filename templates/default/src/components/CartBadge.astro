---
/** Header link to the cart with a live count. Renders as a plain link without JavaScript. */
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<a href="/cart/" class:list={['relative inline-flex items-center gap-1.5', className]} aria-label="Cart" data-cart-badge>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="10" cy="21" r="1" /><circle cx="18" cy="21" r="1" />
  </svg>
  <span hidden class="min-w-5 rounded-full bg-accent px-1.5 text-center text-[11px] font-bold leading-5 text-white" data-cart-count>0</span>
</a>

<script>
  import { cartStore } from '../lib/cart.client'

  const render = () => {
    const n = cartStore.count()
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(n)
      el.hidden = n === 0
    })
  }
  render()
  cartStore.subscribe(render)
</script>
