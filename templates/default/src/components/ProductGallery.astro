---
import type { Product } from '@skuio/storefront'
import { resolveImage, type ResolvedImage } from '../lib/images'

interface Props {
  product: Product
}

const { product } = Astro.props
const gallery = product.images
  .map((i) => ({ image: resolveImage(i), alt: i.alt ?? product.name }))
  .filter((g): g is { image: ResolvedImage; alt: string } => g.image !== null)
const hero = gallery[0]
const heroId = `gallery-hero-${product.sku.replace(/[^a-zA-Z0-9_-]/g, '-')}`
---

{
  hero ? (
    <div>
      <div class="overflow-hidden rounded-lg border border-rule bg-panel-2">
        <img
          src={hero.image.src}
          width={hero.image.width}
          height={hero.image.height}
          alt={hero.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          id={heroId}
          class="h-full w-full object-contain"
        />
      </div>

      {gallery.length > 1 && (
        <ul class="mt-4 grid grid-cols-5 gap-3" data-gallery={heroId}>
          {gallery.map((g, i) => (
            <li>
              <button
                type="button"
                class="block w-full overflow-hidden rounded border border-rule bg-panel-2 p-1 transition hover:border-accent aria-pressed:border-accent"
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={`Show image ${i + 1}`}
                data-full={g.image.src}
                data-alt={g.alt}
              >
                <img src={g.image.src} width={g.image.width} height={g.image.height} alt="" loading="lazy" decoding="async" class="aspect-4/3 w-full object-contain" />
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  ) : (
    <div class="flex aspect-4/3 items-center justify-center rounded-lg border border-rule text-sm text-body/50">No image</div>
  )
}

<script>
  // Thumbnail -> hero swap. Without JavaScript the hero shows the primary image.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const hero = document.getElementById(gallery.dataset.gallery!) as HTMLImageElement | null
    gallery.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-full]')
      if (!button || !hero) return
      hero.src = button.dataset.full!
      hero.alt = button.dataset.alt ?? ''
      gallery.querySelectorAll<HTMLButtonElement>('button[data-full]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button))
      )
    })
  })
</script>
