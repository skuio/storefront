---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ProductCard from '../../components/ProductCard.astro'
import CategoryNav from '../../components/CategoryNav.astro'
import { config, routes, store } from '../../lib/store'

// Rendered per request: the path is the category slug chain (routes.category).
export const prerender = false

const catalog = await store(Astro).catalog.load()
const node = catalog.categoryByPath((Astro.params.path ?? '').split('/').filter(Boolean))
if (!node || node.productCount === 0) return new Response(null, { status: 404 })
const items = catalog.productsIn(node.id, { deep: true })

// Root-first chain to this node, for breadcrumbs and schema.
const chain = []
let cur = node
while (cur) {
  chain.unshift(cur)
  cur = cur.parentId ? catalog.category(cur.parentId)! : undefined!
}

// The description is catalog HTML (seeded, migrated from WooCommerce or pushed by SKU.io), the same
// trusted source as a product description: render it as HTML, and give the meta description its text.
const plainDescription = (node.description ?? '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/&nbsp;/g, ' ')
  .replace(/&(amp|lt|gt|quot|#39|apos);/g, (_, e: string) => ({ amp: '&', lt: '<', gt: '>', quot: '"', '#39': "'", apos: "'" })[e]!)
  .replace(/\s+/g, ' ')
  .trim()

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Shop', href: routes.shop() },
  ...chain.map((c) => ({ label: c.name, href: routes.category(c) })),
]

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, config.url).href })),
}]
---

<BaseLayout title={node.name} description={plainDescription || `${items.length} products in ${node.name} from ${config.name}.`} schema={schema}>
  <div class="mx-auto max-w-6xl px-5 py-10">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 border-b border-rule pb-8">
      <h1 class="display-heading text-5xl">{node.name}</h1>
      {node.description && <div class="prose-store mt-3 max-w-2xl text-sm" data-category-description set:html={node.description} />}
      <p class="mt-3 text-sm text-body/70">{items.length} {items.length === 1 ? 'product' : 'products'}</p>
    </header>

    {node.children.length > 0 && <div class="mt-8"><CategoryNav nodes={node.children} label={`${node.name} categories`} /></div>}

    <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
      {items.map((p, i) => <ProductCard product={p} loading={i < 8 ? 'eager' : 'lazy'} />)}
    </div>
  </div>
</BaseLayout>
