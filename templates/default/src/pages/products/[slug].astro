---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ProductCard from '../../components/ProductCard.astro'
import ProductGallery from '../../components/ProductGallery.astro'
import BuyButton from '../../components/BuyButton.astro'
import AddToCartButton from '../../components/AddToCartButton.astro'
import Price from '../../components/Price.astro'
import { catalog, config, routes } from '../../lib/catalog'
import { resolveImage } from '../../lib/images'

export const prerender = true

export function getStaticPaths() {
  return catalog.products.map((product) => ({ params: { slug: product.slug }, props: { product } }))
}

const { product } = Astro.props
const chain = catalog.breadcrumbs(product)
const leaf = chain.at(-1)
const related = leaf ? catalog.productsIn(leaf.id, { deep: true }).filter((p) => p.id !== product.id).slice(0, 4) : []
const hero = resolveImage(product.images[0])
const plainShort = (product.shortDescription ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Shop', href: routes.shop() },
  ...chain.map((c) => ({ label: c.name, href: routes.category(c) })),
  { label: product.name },
]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    sku: product.sku,
    description: plainShort || undefined,
    offers: {
      '@type': 'Offer',
      price: (product.price.amount / 100).toFixed(2),
      priceCurrency: product.price.currency.toUpperCase(),
      availability: product.available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: new URL(routes.product(product, catalog), config.url).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: new URL(c.href, config.url).href } : {}) })),
  },
]
---

<BaseLayout title={product.name} description={plainShort || `${product.name} from ${config.name}.`} image={hero?.src} schema={schema}>
  <div class="mx-auto max-w-6xl px-5 py-10">
    <Breadcrumbs items={crumbs} />

    <div class="mt-8 grid gap-10 lg:grid-cols-2">
      <ProductGallery product={product} />

      <div>
        {leaf && <p class="text-[11px] font-semibold tracking-widest text-body/60 uppercase">{chain.map((c) => c.name).join(' · ')}</p>}
        <h1 class="mt-2 text-2xl leading-tight font-bold text-ink sm:text-3xl">{product.name}</h1>
        <p class="mt-4"><Price price={product.price} compareAt={product.compareAtPrice} size="lg" /></p>
        <p class="mt-1 text-xs text-body/70">SKU {product.sku} · {product.available ? 'In stock' : 'Sold out'}</p>
        {plainShort && <p class="mt-5 text-sm leading-relaxed">{plainShort}</p>}

        <BuyButton product={product} />
        <AddToCartButton product={product} />

        {product.attributes && Object.keys(product.attributes).length > 0 && (
          <dl class="mt-7 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-rule pt-6 text-sm">
            {Object.entries(product.attributes).map(([k, v]) => (
              <>
                <dt class="font-semibold text-ink">{k}</dt>
                <dd>{v}</dd>
              </>
            ))}
          </dl>
        )}
      </div>
    </div>

    {product.description && (
      <section class="mt-16 max-w-3xl">
        <h2 class="display-heading text-3xl">Details</h2>
        <div class="prose-store mt-4 text-sm" set:html={product.description} />
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16">
        <h2 class="display-heading text-3xl">You might also like</h2>
        <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
