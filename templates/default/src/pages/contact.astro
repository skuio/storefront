---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ContactForm from '../components/ContactForm.astro'
import { config } from '../lib/store'
export const prerender = false
const { phone, phoneE164, email } = config.contact ?? {}
---

<BaseLayout title="Contact" description={`Get in touch with ${config.name}.`}>
  <div class="mx-auto max-w-5xl px-5 py-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <h1 class="display-heading mt-6 text-5xl">Contact us</h1>
    <div class="mt-10 grid gap-12 md:grid-cols-[1fr_1.1fr]">
      <dl class="space-y-6 text-sm">
        {phone && (
          <div>
            <dt class="text-[11px] font-semibold tracking-widest text-body/60 uppercase">Phone</dt>
            <dd class="mt-1"><a href={`tel:${phoneE164 ?? phone}`} class="text-2xl font-bold text-ink hover:text-accent">{phone}</a></dd>
          </div>
        )}
        {email && (
          <div>
            <dt class="text-[11px] font-semibold tracking-widest text-body/60 uppercase">Email</dt>
            <dd class="mt-1"><a href={`mailto:${email}`} class="font-semibold text-accent hover:underline">{email}</a></dd>
          </div>
        )}
      </dl>
      <div><ContactForm /></div>
    </div>
  </div>
</BaseLayout>
