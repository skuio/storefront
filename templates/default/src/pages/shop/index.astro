---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ProductCard from '../../components/ProductCard.astro'
import CategoryNav from '../../components/CategoryNav.astro'
import { catalog, config, routes } from '../../lib/catalog'

export const prerender = true

const tops = catalog.tree().filter((n) => n.productCount > 0)
---

<BaseLayout title="Shop" description={`Every product from ${config.name}.`}>
  <div class="mx-auto max-w-6xl px-5 py-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shop' }]} />
    <header class="mt-6 border-b border-rule pb-8">
      <h1 class="display-heading text-5xl">Everything</h1>
      <p class="mt-3 text-sm">{catalog.products.length} products across {tops.length} categories.</p>
    </header>
    <div class="mt-8"><CategoryNav nodes={tops} label="Jump to a category" /></div>

    {tops.map((node) => (
      <section id={node.slug} class="mt-16 scroll-mt-24">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule pb-3">
          <h2 class="display-heading text-3xl">{node.name}</h2>
          <a href={routes.category(node)} class="text-xs font-semibold tracking-wide text-accent uppercase hover:underline">All {node.name} →</a>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
          {catalog.productsIn(node.id, { deep: true }).map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
