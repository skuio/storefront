---
import { formatMoney, type Order } from '@skuio/storefront'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import { config, routes, store } from '../../../lib/store'
import { resolveImage } from '../../../lib/images'
import { clearSession, readSession } from '../../../lib/account'

export const prerender = false

const s = store(Astro)
const token = readSession(Astro.cookies)
const customer = await s.sessions.resolve(token)
if (!customer) {
  // An expired or revoked session: drop the cookie and start over.
  if (token) clearSession(Astro.cookies)
  return Astro.redirect('/account/', 303)
}
const orders = await s.orders.forCustomer(customer.id)

const fmt = (m: { amount: number; currency: string }) => formatMoney(m, config.locale)
const date = (iso: string) => new Date(iso).toLocaleDateString(config.locale, { year: 'numeric', month: 'short', day: 'numeric' })
const badge = (o: Order): { label: string; cls: string } => {
  switch (o.status) {
    case 'cancelled': return { label: 'Cancelled', cls: 'bg-rule text-body' }
    case 'refunded': return { label: 'Refunded', cls: 'bg-rule text-body' }
    case 'fulfilled': return { label: 'Shipped', cls: 'bg-green-600 text-white' }
    case 'partially_fulfilled': return { label: 'Partially shipped', cls: 'bg-accent/10 text-accent' }
    case 'pending_payment': return { label: 'Awaiting payment', cls: 'bg-accent/10 text-accent' }
    default: return { label: 'Being prepared', cls: 'bg-accent/10 text-accent' }
  }
}
---

<BaseLayout title="Your orders" noindex>
  <div class="mx-auto max-w-3xl px-5 py-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Account', href: '/account/' }, { label: 'Orders' }]} />
    <div class="mt-6 flex flex-wrap items-baseline justify-between gap-4">
      <h1 class="display-heading text-5xl">{customer.name ? `${customer.name.split(' ')[0]}'s orders` : 'Your orders'}</h1>
      <span class="flex items-baseline gap-5">
      <a href="/account/quotes/" class="text-xs font-semibold tracking-wide text-body/70 uppercase hover:text-accent">Quotes</a>
      <form method="POST" action="/api/account/sign-out">
        <button type="submit" class="text-xs font-semibold tracking-wide text-body/70 uppercase hover:text-accent">Sign out</button>
      </form>
      </span>
    </div>
    <p class="mt-2 text-sm text-body/70">Signed in as {customer.email}</p>

    {
      orders.length === 0 ? (
        <div class="mt-8 text-sm">
          <p>No orders yet.</p>
          <a href={routes.shop()} class="mt-6 inline-block rounded-full border-2 border-ink px-7 py-2.5 text-sm font-semibold transition hover:bg-ink hover:text-page">Browse the shop</a>
        </div>
      ) : (
        <ul class="mt-8 space-y-6">
          {orders.map((o) => {
            const b = badge(o)
            return (
              <li class="rounded-lg border border-rule" data-order={o.number}>
                <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule bg-panel px-4 py-3 text-sm">
                  <span>
                    <a href={`/account/orders/${o.id}/`} class="font-semibold text-ink hover:text-accent">Order {config.orders.numberPrefix}{o.number}</a>
                    <span class="text-body/60"> · {date(o.createdAt)}</span>
                  </span>
                  <span class:list={['rounded-full px-2.5 py-0.5 text-[11px] font-bold tracking-wide uppercase', b.cls]}>{b.label}</span>
                </div>
                <ul class="divide-y divide-rule">
                  {o.lines.map((l) => {
                    const img = resolveImage(l.image ? { src: l.image } : null)
                    return (
                      <li class="flex items-center gap-4 px-4 py-3 text-sm">
                        {img ? <img src={img.src} alt="" width="56" height="42" class="h-[42px] w-14 shrink-0 rounded border border-rule bg-panel-2 object-contain" /> : <span class="h-[42px] w-14 shrink-0 rounded border border-rule" />}
                        <span class="min-w-0 flex-1">
                          <span class="font-semibold text-ink">{l.name}</span>
                          <span class="block text-[11px] tracking-wide text-body/60 uppercase">SKU {l.sku}{l.quantity > 1 ? ` · × ${l.quantity}` : ''}{l.fulfilledQuantity > 0 && l.fulfilledQuantity < l.quantity ? ` · ${l.fulfilledQuantity} shipped` : ''}</span>
                        </span>
                        <span class="font-semibold text-ink">{fmt(l.totalAmount)}</span>
                      </li>
                    )
                  })}
                </ul>
                {o.fulfillments.length > 0 && (
                  <div class="space-y-1 border-t border-rule px-4 py-3 text-sm">
                    {o.fulfillments.map((f) => (
                      <p>
                        {[f.carrier, f.service].filter(Boolean).join(' ') || 'Shipment'}
                        {f.trackingNumber && (
                          <>
                            {' '}tracking{' '}
                            {f.trackingUrl ? <a href={f.trackingUrl} class="font-semibold text-accent hover:underline" rel="noopener">{f.trackingNumber}</a> : <strong class="text-ink">{f.trackingNumber}</strong>}
                          </>
                        )}
                        {f.shippedAt && <span class="text-body/60"> · shipped {date(f.shippedAt)}</span>}
                      </p>
                    ))}
                  </div>
                )}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-rule px-4 py-3 text-sm">
                  <span>Total <strong class="text-ink">{fmt(o.total)}</strong>{o.shipping.amount > 0 ? ` · shipping ${fmt(o.shipping)}` : ' · free shipping'}</span>
                  <span class="flex items-center gap-3">
                    <a href={`/account/orders/${o.id}/`} class="text-xs font-semibold tracking-wide text-accent uppercase hover:underline">Details</a>
                    <button type="button" class="rounded-md border-2 border-ink px-4 py-1.5 text-xs font-bold tracking-wide text-ink uppercase transition hover:bg-ink hover:text-page"
                      data-reorder={JSON.stringify(o.lines.map((l) => ({ sku: l.sku, name: l.name, quantity: l.quantity, unitPrice: l.unitAmount, image: resolveImage(l.image ? { src: l.image } : null)?.src })))}>
                      Reorder
                    </button>
                  </span>
                </div>
              </li>
            )
          })}
        </ul>
      )
    }
  </div>
</BaseLayout>

<script>
  import { cartStore } from '../../../lib/cart.client'
  // Reorder = put the lines back in the cart. Prices shown come from the order;
  // checkout re-prices from the catalog, so a changed price is applied then.
  document.querySelectorAll<HTMLButtonElement>('[data-reorder]').forEach((button) => {
    button.addEventListener('click', () => {
      const lines = JSON.parse(button.dataset.reorder!) as { sku: string; name: string; quantity: number; unitPrice: { amount: number; currency: string }; image?: string }[]
      for (const l of lines) cartStore.add({ sku: l.sku, name: l.name, unitPrice: l.unitPrice, image: l.image }, l.quantity, 50)
      window.location.href = '/cart/'
    })
  })
</script>
