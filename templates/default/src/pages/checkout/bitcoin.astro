---
import { formatMoney } from '@skuio/storefront'
import type { BitcoinPaymentAdapter, BitcoinQuote } from '@skuio/storefront/payments/bitcoin'
import { renderSVG } from 'uqr'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { config, paymentContext, paymentMethods, store } from '../../lib/store'

/**
 * Pay an order in bitcoin, on-chain: one fresh address from the merchant's
 * hardware-wallet public key, an amount in BTC held for a few minutes, a QR
 * code, and a live status that moves to the confirmation page by itself.
 */
export const prerender = false

const s = store(Astro)
const id = Astro.url.searchParams.get('order') ?? ''
const key = Astro.url.searchParams.get('key') ?? ''
const order = id && key ? await s.orders.getWithKey(id, key) : null
if (!order) return new Response('Not found', { status: 404 })
const back = `/checkout/success/?order=${encodeURIComponent(id)}&key=${encodeURIComponent(key)}`
if (order.payment.status === 'paid') return Astro.redirect(back, 303)
const btc = paymentMethods(Astro).find((m) => m.id === 'bitcoin') as BitcoinPaymentAdapter | undefined
if (!btc) return Astro.redirect(`/checkout/pending/?order=${encodeURIComponent(id)}&key=${encodeURIComponent(key)}`, 303)

let quote: BitcoinQuote | null = null
try {
  quote = await btc.quote(order, paymentContext(Astro))
} catch (error) {
  console.error('bitcoin page: quote failed', error)
}
const qr = quote ? renderSVG(quote.uri, { border: 1, whiteColor: '#ffffff', blackColor: '#000000' }) : ''
const number = `${config.orders.numberPrefix}${order.number}`
---

<BaseLayout title={`Pay order ${number} with bitcoin`} noindex>
  <div class="mx-auto max-w-xl px-5 py-14" data-btc data-order={id} data-key={key} data-back={back}>
    <p class="text-xs font-semibold tracking-widest text-body/60 uppercase">Order {number} · {formatMoney(order.total, config.locale)}</p>
    <h1 class="display-heading mt-2 text-4xl">Pay with bitcoin</h1>
    {
      quote ? (
        <div class="mt-8 rounded-lg border border-rule p-5">
          <div class="mx-auto w-56 overflow-hidden rounded-md bg-panel-2 p-2" set:html={qr} aria-label="QR code for the bitcoin payment" />
          <dl class="mt-6 space-y-4 text-sm">
            <div>
              <dt class="text-xs font-semibold tracking-wide text-body/60 uppercase">Send exactly</dt>
              <dd class="mt-1 flex items-center justify-between gap-3">
                <span class="font-mono text-2xl font-bold text-ink" data-amount>{quote.amountBtc} BTC</span>
                <button type="button" class="rounded border border-rule px-2 py-1 text-xs" data-copy={quote.amountBtc}>Copy</button>
              </dd>
              <dd class="mt-1 text-xs text-body/70">1 BTC = {formatMoney({ amount: Math.round(quote.rate * 100), currency: order.currency }, config.locale)} · price held until <span data-expires={quote.expiresAt}>{new Date(quote.expiresAt).toLocaleTimeString(config.locale, { hour: 'numeric', minute: '2-digit' })}</span></dd>
            </div>
            <div>
              <dt class="text-xs font-semibold tracking-wide text-body/60 uppercase">To this address</dt>
              <dd class="mt-1 flex items-center justify-between gap-3">
                <span class="font-mono text-sm break-all text-ink" data-address>{quote.address}</span>
                <button type="button" class="rounded border border-rule px-2 py-1 text-xs" data-copy={quote.address}>Copy</button>
              </dd>
            </div>
          </dl>
          <a href={quote.uri} class="mt-6 block w-full rounded-md bg-accent px-6 py-3 text-center text-sm font-bold tracking-wide text-on-accent uppercase">Open in wallet</a>
          <p class="mt-5 flex items-center gap-2 text-sm" role="status" data-status>
            <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-accent"></span>
            <span data-status-text>Waiting for your payment…</span>
          </p>
          <p class="mt-3 text-xs text-body/60">On-chain only (not Lightning). Your order is confirmed after one network confirmation, usually about 10 minutes — you can close this page; we email you either way.</p>
        </div>
      ) : (
        <p class="mt-8 rounded-lg border border-rule p-5 text-sm">We could not reach the bitcoin network just now. Please refresh in a minute — your order is saved.</p>
      )
    }
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-btc]')
  if (root) {
    const text = root.querySelector<HTMLElement>('[data-status-text]')
    const url = `/api/payments/bitcoin?order=${encodeURIComponent(root.dataset.order!)}&key=${encodeURIComponent(root.dataset.key!)}`
    const say = (t: string) => { if (text) text.textContent = t }
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        await navigator.clipboard.writeText(b.dataset.copy ?? '')
        b.textContent = 'Copied'
        setTimeout(() => (b.textContent = 'Copy'), 1500)
      })
    )
    // The server renders in UTC; show the hold time in the buyer's own clock.
    root.querySelectorAll<HTMLElement>('[data-expires]').forEach((el) => {
      el.textContent = new Date(el.dataset.expires!).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
    })
    let shownAddress = root.querySelector('[data-address]')?.textContent
    async function poll() {
      try {
        const res = await fetch(url, { headers: { accept: 'application/json' } })
        const q = (await res.json()) as { ok: boolean; status?: string; address?: string; confirmations?: number; receivedSats?: number; amountSats?: number; error?: string }
        if (q.status === 'paid') {
          say('Payment confirmed — taking you to your order…')
          location.href = root!.dataset.back!
          return
        }
        if (q.address && q.address !== shownAddress) location.reload()
        if (q.status === 'seen') say('Payment seen on the network — waiting for 1 confirmation (about 10 minutes).')
        else if (q.status === 'underpaid') say(`We received ${(q.receivedSats! / 1e8).toFixed(8)} BTC — less than the ${(q.amountSats! / 1e8).toFixed(8)} BTC due. Please contact us.`)
        else if (q.status === 'expired') location.reload()
        else if (!q.ok && q.error) say(q.error)
      } catch {
        /* keep polling */
      }
      setTimeout(poll, 10_000)
    }
    setTimeout(poll, 5_000)
    shownAddress ??= ''
  }
</script>
