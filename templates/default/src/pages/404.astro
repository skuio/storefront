---
import BaseLayout from '../layouts/BaseLayout.astro'
import { routes } from '../lib/store'
export const prerender = false
---

<BaseLayout title="Page not found" noindex>
  <div class="mx-auto max-w-xl px-5 py-24 text-center">
    <h1 class="display-heading text-5xl">Page not found</h1>
    <p class="mt-4 text-sm">That page does not exist or has moved.</p>
    <a href={routes.shop()} class="mt-8 inline-block rounded-full border-2 border-ink px-7 py-2.5 text-sm font-semibold transition hover:bg-ink hover:text-white">Back to the shop</a>
  </div>
</BaseLayout>
