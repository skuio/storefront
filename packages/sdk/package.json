{
  "name": "@skuio/storefront",
  "version": "0.7.0",
  "description": "The store platform behind SKU.io storefronts: catalog, checkout, orders, buyer portal and the Store API over one SQL driver — Cloudflare D1 or SQLite on any Node host. Framework-agnostic; pairs with the Astro reference template.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/skuio/storefront",
    "directory": "packages/sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "import": "./dist/payments.js"
    },
    "./payments/stripe": {
      "types": "./dist/payments/stripe.d.ts",
      "import": "./dist/payments/stripe.js"
    },
    "./payments/manual": {
      "types": "./dist/payments/manual.d.ts",
      "import": "./dist/payments/manual.js"
    },
    "./payments/paypal": {
      "types": "./dist/payments/paypal.d.ts",
      "import": "./dist/payments/paypal.js"
    },
    "./payments/btcpay": {
      "types": "./dist/payments/btcpay.d.ts",
      "import": "./dist/payments/btcpay.js"
    },
    "./payments/bitcoin": {
      "types": "./dist/payments/bitcoin.d.ts",
      "import": "./dist/payments/bitcoin.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "import": "./dist/mail.js"
    },
    "./mail/sendgrid": {
      "types": "./dist/mail/sendgrid.d.ts",
      "import": "./dist/mail/sendgrid.js"
    },
    "./mail/console": {
      "types": "./dist/mail/console.d.ts",
      "import": "./dist/mail/console.js"
    },
    "./mail/cloudflare": {
      "types": "./dist/mail/cloudflare.d.ts",
      "import": "./dist/mail/cloudflare.js"
    },
    "./db/sqlite": {
      "types": "./dist/db/sqlite.d.ts",
      "import": "./dist/db/sqlite.js"
    },
    "./db/migrations/*": "./db/migrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "db"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "stripe": ">=17"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^12.11.1",
    "stripe": "^19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@scure/bip32": "^2.4.0",
    "@scure/btc-signer": "^2.4.1"
  }
}
